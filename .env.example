# Google Maps API Key
# Copy this file to .env and fill in your key.
# The .env file is gitignored — never commit it.
REACT_APP_GOOGLE_MAPS_API_KEY=your_key_here

# ── Lab routes (sandbox pages under /lab/) ──
# Leave BOTH unset for public production builds. craco.config.js then rewrites
# the lab imports to a stub, so none of the sandbox code — or its URL — reaches
# the bundle.
#
# To work on the lab locally, set:
#   REACT_APP_LAB=1
#   REACT_APP_LAB_TOKEN=<a random string>
# then open /lab-<token>
#
# Generate a token with:
#   node -e "console.log(require('crypto').randomBytes(9).toString('base64url'))"
#
# Keep the token in .env (gitignored) — this repository is public, so a token
# committed to source would be published.
#
# NOTE: this makes the page UNLISTED, not authenticated. For real protection
# add HTTP basic auth on /lab/ in nginx.conf.
REACT_APP_LAB=
REACT_APP_LAB_TOKEN=
